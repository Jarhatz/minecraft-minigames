tag @s add bs_done
scoreboard players add @s ch_points 1
scoreboard players add @s bs_display 1
title @s title [{"text":"✔","color":"green","bold":true}]
title @s subtitle [{"text":"Block found - you are safe!","color":"green"}]
tellraw @a [{"text":"[Block Shuffle] ","color":"gold","bold":true},{"selector":"@s","color":"green","bold":true},{"text":" found their block!","color":"white"}]

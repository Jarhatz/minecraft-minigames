# Copy to .env (gitignored) and fill in.
TZ=America/Los_Angeles

# Long random secret. Generate with: openssl rand -hex 24
RCON_PASSWORD=__CHANGE_ME__

# Comma-separated Minecraft usernames allowed to join each server.
# Empty = nobody can join (safe default).
WHITELIST_VANILLA=
WHITELIST_FORGE=

# Usernames given operator on both servers.
OPS=

# Modrinth mods for the Forge server as slug:versionId (pinned; clients must match exactly).
FORGE_MODRINTH_PROJECTS=upgrade-items:nIG81STn,yyzs-backpack:Hr3jMmK6,realistic-nametag:eQclUUrT,saros-worldborder-customizer:mfURH8OS,kotlin-for-forge:Zsh14XeQ

# Container user; must own deploy/data (defaults to your uid/gid).
MC_UID=1000
MC_GID=1000

# Minimal server.properties for the minigames server (Forge 1.20.1).
# Fill in the placeholders. Keep rcon.password SECRET — never commit the real file.
# A large, grassy, varied map suits these games; large_biomes is recommended.

motd=Party Minigames
level-type=minecraft\:large_biomes
level-seed=
max-players=8
online-mode=true
white-list=true
enforce-whitelist=true
difficulty=normal
spawn-protection=0
view-distance=10
simulation-distance=8
max-tick-time=0

# RCON — required for the management scripts.
enable-rcon=true
rcon.port=25575
rcon.password=__CHANGE_ME__
broadcast-rcon-to-ops=false

server-port=25565
